# Postgres connection string (Neon). Never commit a real one.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
NODE_ENV=development
PORT=3000

# Comma-separated frontend origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000

# Frontend base URL, used in email links
CLIENT_URL=http://localhost:3000
# Optional overrides (defaults: CLIENT_URL/auth/reset-password and CLIENT_URL/login)
RESET_PASSWORD_URL=
VERIFY_EMAIL_REDIRECT_URL=
# Public URL of this API for verification links (default: taken from the request)
API_URL=

# Email (Resend). Leave the key empty in dev to log emails instead of sending.
RESEND_API_KEY=
# Must be on a domain verified in Resend (gmail.com etc. will be rejected)
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# Public base URL for product image storage keys (e.g. R2 public bucket / CDN)
IMAGE_BASE_URL=

# Minutes stock is held for a pending order
RESERVATION_TTL_MINUTES=15

# Used only by `npm run db:seed` to create the first admin (min 12 chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# OPay (not wired up yet)
OPAY_MERCHANT_ID=
OPAY_SECRET_KEY=
